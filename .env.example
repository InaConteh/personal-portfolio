# Contact form delivery (FR-5). Without RESEND_API_KEY the form falls back to EmailJS in the browser.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend; onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Cloudflare Turnstile (optional; enabled when both are set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical URL used for the sitemap, OG tags and structured data
NEXT_PUBLIC_SITE_URL=
